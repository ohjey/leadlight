{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "Leadlight",
	"description": "OptiFine-format shader packs (Photon, Complementary, BSL, ...) on Metallum's Metal renderer for Apple silicon Macs, unmodified. Built on Vitrail by avpbynf.",
	"authors": [
		"OhJey"
	],
	"contributors": [
		"avpbynf (Vitrail, the shader engine Leadlight is built on)"
	],
	"contact": {
		"homepage": "https://github.com/ohjey/leadlight",
		"sources": "https://github.com/ohjey/leadlight",
		"issues": "https://github.com/ohjey/leadlight/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "leadlight.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.leadlight.fabric.LeadlightFabric"
		],
		"sodium:config_api_user": [
			"dev.leadlight.sodium.ConfigEntry"
		]
	},
	"mixins": [
		"leadlight.mixins.json",
		"leadlight-game.mixins.json",
		"leadlight-fabric.mixins.json",
		"leadlight-dh.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min_version}",
		"minecraft": ">=${minecraft_version} <${minecraft_next}",
		"metallum": "${metallum_version}",
		"sodium": "0.9.x",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*"
	},
	"breaks": {
		"vitrail": "*",
		"vitrail_metallum": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.features.render.world.sky": false
		}
	}
}
