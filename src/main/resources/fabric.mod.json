{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "Vitrail for Metallum",
	"description": "OptiFine-format shader packs on Metallum's Metal renderer. A fork of Vitrail Shaders by avpbynf.",
	"authors": [
		"avpbynf (Vitrail)"
	],
	"contact": {
		"sources": "https://github.com/avpbynf/Vitrail-Shaders"
	},
	"license": "LGPL-3.0-only",
	"icon": "vitrail.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.vitrailmetal.fabric.VitrailFabric"
		],
		"sodium:config_api_user": [
			"dev.vitrailmetal.sodium.ConfigEntry"
		]
	},
	"mixins": [
		"vitrail-metallum.mixins.json",
		"vitrail-metallum-game.mixins.json",
		"vitrail-metallum-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min_version}",
		"minecraft": ">=${minecraft_version} <${minecraft_next}",
		"metallum": "${metallum_version}",
		"sodium": "0.9.x",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*"
	},
	"breaks": {
		"vitrail": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.features.render.world.sky": false
		}
	}
}
